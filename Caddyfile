:{$PORT:80} {
	root * /srv
	encode gzip zstd

	@fonts path /assets/fonts/*
	@seiten not path /assets/* /api/*
	@api path /api/*
	@www host www.pixelkiez.de

	# Eine Adresse, nicht zwei. Ohne diese Umleitung waeren pixelkiez.de und
	# www.pixelkiez.de fuer eine Suchmaschine zwei Seiten mit demselben Text,
	# und die Signale verteilten sich auf beide. 301 statt 302, damit die
	# Umleitung als dauerhaft gilt und die Bewertung mit uebergeht. {uri}
	# haengt Pfad und Abfrage an, damit Unterseiten nicht auf der Startseite
	# landen.
	#
	# Greift erst, wenn www ueberhaupt bis hierher kommt: die Adresse muss auf
	# Railway zeigen UND dort als eigene Domain eingetragen sein, sonst
	# scheitert schon der TLS-Handschlag. Die Regel steht bereit, kostet
	# nichts und wirkt in dem Moment, in dem der Platz dafuer da ist.
	redir @www https://pixelkiez.de{uri} permanent

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Schriften tragen seit dem Build einen Inhalts-Hash im Dateinamen. Aendert
	# sich eine Schrift, aendert sich ihr Name — deshalb ist "immutable" hier
	# gefahrlos und ein Jahr angemessen.
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	# Die Seiten tragen CSS und JS eingebettet, es gibt also keine getrennten
	# Mitteldateien mehr, die veralten koennten. Der Matcher deckt bewusst auch
	# den blanken Pfad "/" ab — die frueherere Regel /*.html tat das nicht, die
	# Startseite lief dadurch ganz ohne Cache-Header.
	header @seiten Cache-Control "public, max-age=300"

	# Das Kontaktformular geht an den Formulardienst. Ueber denselben Host
	# ausgeliefert, damit es kein CORS und keine zweite Domain braucht —
	# fuer den Browser ist es dieselbe Herkunft wie die Seite.
	#
	# API_UPSTREAM zeigt im Betrieb auf das private Netz von Railway, z. B.
	#   bds-api.railway.internal:3000
	# Ist die Variable nicht gesetzt, laeuft die Seite ohne Formulardienst und
	# das Formular weicht selbsttaetig auf den E-Mail-Pfad aus.
	handle @api {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:3000} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		file_server
	}
}
