:{$PORT:80} {
	root * /srv
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Schriften sind versioniert unveraenderlich, CSS/JS kurz cachen
	header /assets/fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/css/*   Cache-Control "public, max-age=3600"
	header /assets/js/*    Cache-Control "public, max-age=3600"
	header /*.html         Cache-Control "public, max-age=300"
}
